<Window x:Class="BluetoothAudioReceiver.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="帮助与故障排查"
        Height="550" Width="500"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent">
    
    <Border Background="{StaticResource BackgroundBrush}" 
            BorderBrush="{StaticResource BorderBrush}" 
            BorderThickness="1" 
            CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Custom Title Bar -->
            <Border Background="{StaticResource SurfaceBrush}" 
                    CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="❓" FontSize="14" Margin="0,0,8,0"/>
                        <TextBlock Text="帮助与故障排查"
                                   FontSize="13" 
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>
                    
                    <Button Content="✕" 
                            Click="CloseButton_Click"
                            Style="{StaticResource CloseButtonStyle}"
                            HorizontalAlignment="Right"
                            FontSize="12"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            ToolTip="关闭"
                            AutomationProperties.Name="关闭"/>
                </Grid>
            </Border>
            
            <!-- Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
                <StackPanel>
                    
                    <!-- Quick Start -->
                    <TextBlock Text="快速开始" Style="{StaticResource SectionHeaderStyle}"/>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12">
                                <Run FontWeight="SemiBold">1.</Run> 在 Windows 蓝牙设置中配对手机<LineBreak/>
                                <Run FontWeight="SemiBold">2.</Run> 选择手机并点击“连接”<LineBreak/>
                                <Run FontWeight="SemiBold">3.</Run> 在手机上选择电脑作为音频输出<LineBreak/>
                                <Run FontWeight="SemiBold">4.</Run> 开始播放手机音频
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    
                    <!-- Known Issues -->
                    <TextBlock Text="常见问题" Style="{StaticResource SectionHeaderStyle}"/>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                        <StackPanel>
                            
                            <!-- Issue 1 -->
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="网络速度变慢"
                                           FontWeight="SemiBold" 
                                           Foreground="{StaticResource WarningBrush}"
                                           Margin="0,0,0,6"/>
                                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12">
                                    蓝牙与 2.4 GHz Wi-Fi 可能互相干扰。
                                </TextBlock>
                                <Border Background="{StaticResource SurfaceVariantBrush}" 
                                        CornerRadius="6" 
                                        Padding="12" 
                                        Margin="0,8,0,0">
                                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12">
                                        <Run FontWeight="SemiBold">建议：</Run><LineBreak/>
                                        优先使用 5 GHz Wi-Fi，并让手机靠近电脑。
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                            
                            <!-- Issue 2 -->
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="列表中没有手机"
                                           FontWeight="SemiBold" 
                                           Foreground="{StaticResource WarningBrush}"
                                           Margin="0,0,0,6"/>
                                <Border Background="{StaticResource SurfaceVariantBrush}" 
                                        CornerRadius="6" 
                                        Padding="12">
                                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12">
                                        <Run FontWeight="SemiBold">检查：</Run><LineBreak/>
                                        手机与电脑是否已经在 Windows 蓝牙设置中配对？<LineBreak/>
                                        两端蓝牙是否已开启？然后点击刷新设备。
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                            
                            <!-- Issue 3 -->
                            <StackPanel>
                                <TextBlock Text="已连接但没有声音"
                                           FontWeight="SemiBold" 
                                           Foreground="{StaticResource WarningBrush}"
                                           Margin="0,0,0,6"/>
                                <Border Background="{StaticResource SurfaceVariantBrush}" 
                                        CornerRadius="6" 
                                        Padding="12">
                                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12">
                                        <Run FontWeight="SemiBold">建议：</Run><LineBreak/>
                                        点击主界面的“无声音？”查看蓝牙、接收通道和电脑输出状态。<LineBreak/>
                                        可点“重新建立接收通道”；同时检查手机媒体输出是否选中电脑。<LineBreak/>
                                        原版 BleAudio 与本应用建议一次只运行一个。
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                            
                        </StackPanel>
                    </Border>
                    
                    <!-- System Requirements -->
                    <TextBlock Text="系统要求与编码" Style="{StaticResource SectionHeaderStyle}"/>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12">
                            Windows 10 2004 或更新版本、可用的蓝牙适配器，以及已配对的手机。<LineBreak/>
                            本应用通过 Windows A2DP 接收手机音频。AAC 等编码由系统与手机协商，应用无法强制指定；当前版本不显示实际协商结果。
                        </TextBlock>
                    </Border>
                    
                    <!-- Version Info -->
                    <TextBlock Text="关于" Style="{StaticResource SectionHeaderStyle}"/>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="12">
                                <Run Text="独立替代版 · 基于 MIT 许可项目"/><LineBreak/>
                                <Run Text="使用 .NET 8 与 Windows 蓝牙音频接口"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
