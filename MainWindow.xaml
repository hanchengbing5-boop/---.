<Window x:Class="BluetoothAudioReceiver.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BluetoothAudioReceiver"
        Title="手机音频接收器" Width="480" Height="630"
        MinWidth="430" MinHeight="550"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True"
        ResizeMode="CanMinimize" Background="Transparent">
    <Border Background="#101722" BorderBrush="#304158" BorderThickness="1" CornerRadius="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#182538" CornerRadius="18,18,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="18,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="32" Height="32" CornerRadius="10" Background="#298BE8">
                            <Viewbox Width="17" Height="17">
                                <Path Fill="White" Data="M17.71 7.71L12 2h-1v7.59L6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 11 14.41V22h1l5.71-5.71-4.3-4.29 4.3-4.29zM13 5.83l1.88 1.88L13 9.59V5.83zm1.88 10.46L13 18.17v-3.76l1.88 1.88z"/>
                            </Viewbox>
                        </Border>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="手机音频接收器" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                            <TextBlock Text="让电脑播放手机的声音" FontSize="10" Foreground="#94A8BE" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="─" Click="MinimizeButton_Click" Style="{StaticResource TitleBarButtonStyle}"
                                Foreground="#B9C8D8" FontSize="12" ToolTip="缩到系统托盘"
                                AutomationProperties.Name="缩到系统托盘"/>
                        <Button Content="×" Click="CloseButton_Click" Style="{StaticResource CloseButtonStyle}"
                                Foreground="#B9C8D8" FontSize="18" ToolTip="关闭窗口"
                                AutomationProperties.Name="关闭窗口"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="22,20,22,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" CornerRadius="14" Padding="19,17" BorderThickness="1" BorderBrush="#35516D">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#1D3855" Offset="0"/>
                            <GradientStop Color="#172637" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="50" Height="50" Background="#244D73" CornerRadius="15" VerticalAlignment="Center">
                            <Viewbox Width="25" Height="25">
                                <Path Fill="#BDE1FF" Data="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"/>
                            </Viewbox>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#F3B759"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                    <Setter Property="Fill" Value="#42D6A4"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="连接状态" FontSize="11" Foreground="#A7BDD3"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Status}" FontSize="23" FontWeight="SemiBold"
                                       Foreground="White" Margin="0,5,0,0"/>
                            <TextBlock Text="{Binding StatusDetail}" FontSize="11" Foreground="#B9CADC"
                                       TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="0,23,0,10">
                    <TextBlock Text="选择要连接的手机" FontSize="15" FontWeight="SemiBold"
                               Foreground="White" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="所有设备" Click="DeviceInventoryButton_Click"
                                Style="{StaticResource SecondaryButtonStyle}" Padding="10,5" Margin="0,0,8,0"
                                ToolTip="查看蓝牙设备和 USB 输入接收器"/>
                        <Button Command="{Binding RefreshDevicesCommand}" Content="⟳  刷新"
                                Style="{StaticResource SecondaryButtonStyle}" Padding="10,5"
                                ToolTip="重新查找可接收手机声音的设备"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="2" Background="#172231" CornerRadius="14" BorderBrush="#2B3B4F" BorderThickness="1" Padding="10">
                    <Grid>
                        <ListBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,7"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="DeviceCard" Background="#202F43" BorderBrush="#34475F"
                                                        BorderThickness="1" CornerRadius="10" Padding="12,10" Cursor="Hand">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="DeviceCard" Property="Background" Value="#29405B"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="DeviceCard" Property="Background" Value="#244665"/>
                                                        <Setter TargetName="DeviceCard" Property="BorderBrush" Value="#4EACFF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="38" Height="38" CornerRadius="10" Background="#365A7B">
                                            <TextBlock Text="♫" FontSize="19" Foreground="#D6EDFF"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="White" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding DisplayStatus}" FontSize="10" Foreground="#A7BDD3"
                                                       Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="›" FontSize="23" Foreground="#79BBF6"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="270">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Devices.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="还没有找到手机" FontSize="15" FontWeight="SemiBold"
                                       Foreground="White" TextAlignment="Center"/>
                            <TextBlock Text="先在 Windows 蓝牙设置中与手机配对，然后点击刷新。"
                                       FontSize="11" Foreground="#A8BDD2" TextWrapping="Wrap"
                                       TextAlignment="Center" Margin="0,8,0,14"/>
                            <Button Content="打开蓝牙设置" Click="OpenBluetoothSettings_Click"
                                    Style="{StaticResource SecondaryButtonStyle}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Grid.Row="3" Text="{Binding ErrorMessage}" Foreground="#FF8C8C"
                           FontSize="11" TextWrapping="Wrap" Margin="2,10,2,0"/>

                <StackPanel Grid.Row="4" Margin="0,16,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="连接所选设备" Command="{Binding OpenConnectionCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" Padding="12,11">
                            <Button.IsEnabled>
                                <MultiBinding>
                                    <MultiBinding.Converter>
                                        <local:CanConnectConverter/>
                                    </MultiBinding.Converter>
                                    <Binding Path="SelectedDevice"/>
                                    <Binding Path="IsConnected"/>
                                    <Binding Path="IsConnecting"/>
                                </MultiBinding>
                            </Button.IsEnabled>
                        </Button>
                        <Button Grid.Column="2" Content="断开连接" Command="{Binding CloseConnectionCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding IsConnected}"/>
                    </Grid>
                    <Grid Margin="2,14,2,0">
                        <TextBlock Text="最小化后会在右下角继续运行 · 右键图标可管理设备"
                                   FontSize="10" Foreground="#8299B0" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="无声音？" Click="TroubleshootButton_Click" Background="Transparent" BorderThickness="0"
                                    Foreground="#9FCBF1" Cursor="Hand" Padding="6,2"/>
                            <Button Content="帮助" Click="HelpButton_Click" Background="Transparent" BorderThickness="0"
                                    Foreground="#9FCBF1" Cursor="Hand" Padding="6,2"/>
                            <Button Content="设置" Click="SettingsButton_Click" Background="Transparent" BorderThickness="0"
                                    Foreground="#9FCBF1" Cursor="Hand" Padding="6,2"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
